{
  "name": "roloai",
  "private": true,
  "version": "1.01.01",
  "workspaces": [
    "shared",
    "web",
    "mobile"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace web",
    "build:web": "npm run build --workspace web",
    "deploy:web": "npm run build --workspace web && firebase deploy --only hosting",
    "start:mobile": "npm run start --workspace mobile",
    "build:mobile:ios": "npm run build:ios --workspace mobile",
    "deploy:ios": "npm run version:bug && cd mobile && eas build --platform ios --profile production --local --auto-submit",
    "version:bug": "node scripts/version.js bug",
    "version:minor": "node scripts/version.js minor",
    "version:major": "node scripts/version.js major"
  }
}

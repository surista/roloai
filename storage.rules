rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Mirrors the owner check in firestore.rules — see the rationale there.
    function isOwner() {
      return request.auth != null && request.auth.token.email == 'surista@gmail.com';
    }

    match /cards/{cardId}/{fileName} {
      allow read, write: if isOwner();
    }
  }
}
